Bootstrap: docker
From: continuumio/miniconda3:latest

%files
    requirements.txt /opt/requirements.txt

%post
    conda install -y -c conda-forge \
        python=3.11 \
        harp \
        pip

    pip install --no-cache-dir -r /opt/requirements.txt

    conda clean -afy

%environment
    export PATH=/opt/conda/bin:$PATH

%runscript
    exec python "$@"
